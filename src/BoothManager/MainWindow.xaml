<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BoothManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/legends_alley_logo.png" Width="24" Height="24"/>
                <TextBlock Text="BOOTH MANAGER" FontSize="13" FontWeight="Bold" CharacterSpacing="120" VerticalAlignment="Center"/>
                <TextBlock Text="Legends Alley" FontSize="12" Foreground="{StaticResource AlleyMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="UserChip" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        Margin="0,0,150,0" VerticalAlignment="Center" Visibility="Collapsed">
                <PersonPicture x:Name="UserAvatar" Width="24" Height="24"/>
                <TextBlock x:Name="UserNameText" FontSize="12" VerticalAlignment="Center"/>
                <Border x:Name="RoleBadge" CornerRadius="9" Padding="8,2" VerticalAlignment="Center" Background="#3300E6CC">
                    <TextBlock x:Name="RoleBadgeText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Discord-style update banner -->
        <InfoBar x:Name="UpdateBar" Grid.Row="1" Severity="Success" IsOpen="False" IsClosable="True" Margin="8,0,8,0">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateNowBtn" Content="Update now" Click="UpdateNowBtn_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView x:Name="NavView" Grid.Row="2" SelectionChanged="NavView_SelectionChanged"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="216" IsPaneVisible="False"
                        IsPaneToggleButtonVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDashboard" Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBooths" Content="Booths" Tag="booths">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAlley" Content="Alley Service" Tag="alley">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBuilder" Content="Booth Builder" Tag="builder">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavStandee" Content="Standee Studio" Tag="standee">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAtlas" Content="Image Atlas" Tag="atlas">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAdmin" Content="Admin" Tag="admin" Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7EF;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
