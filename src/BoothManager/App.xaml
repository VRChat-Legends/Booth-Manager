<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BoothManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Legends Alley palette -->
            <Color x:Key="AlleyTealColor">#00E6CC</Color>
            <Color x:Key="AlleyDeepColor">#080B10</Color>
            <SolidColorBrush x:Key="AlleyTealBrush" Color="{StaticResource AlleyTealColor}" />
            <SolidColorBrush x:Key="AlleyMutedBrush" Color="#8B95A0" />
            <SolidColorBrush x:Key="AlleyCardBrush" Color="#141A22" />
            <SolidColorBrush x:Key="AlleyCardBorderBrush" Color="#2200E6CC" />
            <CornerRadius x:Key="CardRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
