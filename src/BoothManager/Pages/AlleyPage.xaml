<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.AlleyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header / connection -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Legends Alley" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="ConnSubtitle" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"
                           Text="Connect to alley.vrchatlegends.com to manage your community, booth uploads, and events."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenSiteBtn" Click="OpenSiteBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14"/>
                        <TextBlock Text="vrchatlegends.com/alley"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ConnectBtn" Click="ConnectBtn_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FB;" FontSize="14"/>
                        <TextBlock x:Name="ConnectBtnText" Text="Connect"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- disconnected panel -->
        <Border x:Name="DisconnectedPanel" Grid.Row="1" Background="{StaticResource AlleyCardBrush}"
                BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="40" MaxWidth="600"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE968;" FontSize="42" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Not connected to the Alley service" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AlleyMutedBrush}"
                           Text="This is the same sign-in the Legends Alley SDK uses. Community owners and booth managers see their community here; Alley staff get the full admin console: applications, communities, booth uploads, and events."/>
                <TextBlock x:Name="ConnError" Foreground="#FF6B81" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Visibility="Collapsed"/>
                <ProgressRing x:Name="ConnRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- connected: pivot -->
        <Pivot x:Name="MainPivot" Grid.Row="1" Visibility="Collapsed">
            <PivotItem Header="My community">
                <ScrollViewer Padding="0,10,0,0">
                    <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">
                        <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <PersonPicture x:Name="CommunityLogo" Width="72" Height="72"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="CommunityName" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="CommunityMeta" FontSize="12" Foreground="{StaticResource AlleyMutedBrush}"/>
                                    <TextBlock x:Name="CommunityRole" FontSize="12" Foreground="{StaticResource AlleyTealBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Profile" FontWeight="SemiBold"/>
                                <TextBox x:Name="CommDescBox" Header="Description" TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="500" Height="90"/>
                                <TextBox x:Name="CommInviteBox" Header="Discord invite URL" PlaceholderText="https://discord.gg/..."/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveCommunityBtn" Click="SaveCommunityBtn_Click" Style="{StaticResource AccentButtonStyle}" Content="Save profile"/>
                                    <Button x:Name="UploadLogoBtn" Click="UploadLogoBtn_Click" Content="Upload logo..."/>
                                    <Button x:Name="SyncRolesBtn" Click="SyncRolesBtn_Click" Content="Sync Discord roles"/>
                                </StackPanel>
                                <TextBlock x:Name="CommunityStatus" FontSize="12" Foreground="{StaticResource AlleyTealBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="20">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="Booth uploads" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MyBoothsCount" HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{StaticResource AlleyMutedBrush}"/>
                                </Grid>
                                <StackPanel x:Name="MyBoothsList" Spacing="8"/>
                                <TextBlock x:Name="MyBoothsEmpty" Text="No booth uploads yet. Upload from Unity with the Legends Alley SDK."
                                           FontSize="12" Foreground="{StaticResource AlleyMutedBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Events" FontWeight="SemiBold"/>
                                <StackPanel x:Name="EventsList" Spacing="8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="StaffAppsTab" Header="Applications">
                <Grid RowSpacing="10" Padding="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="AppStatusCombo" SelectedIndex="0" SelectionChanged="AppStatusCombo_SelectionChanged">
                            <ComboBoxItem Content="Pending" Tag="pending"/>
                            <ComboBoxItem Content="Approved" Tag="approved"/>
                            <ComboBoxItem Content="Rejected" Tag="rejected"/>
                        </ComboBox>
                        <Button x:Name="RefreshAppsBtn" Click="RefreshAppsBtn_Click">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="AppsList" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="StaffCommunitiesTab" Header="Communities">
                <ScrollViewer Padding="0,10,0,0">
                    <StackPanel x:Name="CommunitiesList" Spacing="8"/>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="StaffBoothsTab" Header="Booth uploads">
                <ScrollViewer Padding="0,10,0,0">
                    <StackPanel x:Name="StaffBoothsList" Spacing="8"/>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
