<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Admin" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Padding="8,5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>
            <TextBlock Text="Every device signed in to Booth Manager. Revoking a device forces that person to sign in again; if their team role was removed they will be blocked."
                       Foreground="{StaticResource AlleyMutedBrush}" TextWrapping="Wrap" Margin="0,-6,0,0"/>

            <InfoBar x:Name="StatusBar" IsOpen="False"/>
            <StackPanel x:Name="LinksPanel" Spacing="8"/>
            <TextBlock x:Name="EmptyText" Text="No devices are signed in." Foreground="{StaticResource AlleyMutedBrush}" Visibility="Collapsed"/>

            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="How access works" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource AlleyMutedBrush}" TextWrapping="Wrap"
                               Text="Site admins see everything, including this tab. Team members only see the booths assigned to them (set per booth in the Booths tab) and cannot publish, reassign, create, or delete booths. Anyone without a team role on vrchatlegends.com is blocked at login, and roles are re-checked on every request."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
