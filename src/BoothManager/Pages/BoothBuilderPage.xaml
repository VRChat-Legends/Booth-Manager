<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.BoothBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28">
        <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="40"
                MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE90F;" FontSize="44" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Booth Builder" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border Background="#3300E6CC" CornerRadius="20" Padding="14,5" HorizontalAlignment="Center">
                    <TextBlock Text="COMING SOON" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}" CharacterSpacing="150"/>
                </Border>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AlleyMutedBrush}"
                           Text="Build your booth on the official Legends Alley prefab: a live 3D model of the booth where you place your images, set your group button (grp_ id), your VRChat avatar id, and your world ids, then see exactly how it will look in the Alley."/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AlleyMutedBrush}"
                           Text="Until then, everything the Alley team needs lives in the Booths tab: booth images, group id, avatar id, and world ids you save there are already wired up."/>
                <Button x:Name="OpenBoothsBtn" Click="OpenBoothsBtn_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                        <TextBlock Text="Open Booths"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
