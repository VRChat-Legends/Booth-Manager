<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.BoothBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- 3D teaser viewport -->
        <Border Grid.Column="0" Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="2">
            <Grid>
                <Grid x:Name="ViewportHost"/>
                <StackPanel x:Name="ModelMissingPanel" Visibility="Collapsed" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE90F;" FontSize="40" Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Booth model not found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Assets\BoothModel\booth.obj is missing from this build."
                               Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <ProgressRing x:Name="LoadRing" IsActive="False" Width="44" Height="44"/>
                <Border x:Name="StatsBadge" Visibility="Collapsed" Background="#CC0D1117" CornerRadius="8" Padding="10,6"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                    <TextBlock x:Name="StatsText" FontSize="11" Foreground="{StaticResource AlleyMutedBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- coming soon panel -->
        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="24">
                <StackPanel Spacing="14">
                    <FontIcon Glyph="&#xE90F;" FontSize="36" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Booth Builder" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Background="#3300E6CC" CornerRadius="20" Padding="14,5" HorizontalAlignment="Center">
                        <TextBlock Text="COMING SOON" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AlleyTealBrush}" CharacterSpacing="150"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"
                               Text="That is the official Legends Alley booth prefab rendering live in the app. Soon you will place your own images on the posters and screens, set your group button, avatar pedestal, and world portals, and preview exactly how your booth will look at the event."/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"
                               Text="Until then, booth images, group id, avatar id, and world ids all live in the Booths tab."/>
                    <Button x:Name="OpenBoothsBtn" Click="OpenBoothsBtn_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock Text="Open Booths"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Text="drag to orbit  |  scroll to zoom" FontSize="11" Opacity="0.45" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
