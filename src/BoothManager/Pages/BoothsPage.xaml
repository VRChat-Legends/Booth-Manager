<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.BoothsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Booth list -->
        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Booths" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Padding="8,5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
                <Button x:Name="NewBtn" Click="NewBtn_Click" Padding="10,5" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="New" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <ListView x:Name="BoothList" Grid.Row="1" SelectionChanged="BoothList_SelectionChanged"
                      Background="{StaticResource AlleyCardBrush}" CornerRadius="{StaticResource CardRadius}"
                      BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1" Padding="4"/>
        </Grid>

        <!-- Editor -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="NoSelectionText" Text="Select a booth on the left, or create a new one."
                       Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="EditorScroll" Visibility="Collapsed">
                <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left" Padding="4,0,16,24">
                    <TextBlock x:Name="EditorTitle" Text="Booth" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="EditorMeta" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12" Margin="0,-8,0,0"/>

                    <TextBox x:Name="NameBox" Header="Booth name" PlaceholderText="My community booth"/>
                    <TextBox x:Name="DescBox" Header="Description" PlaceholderText="What is this community about?"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="84" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GroupBox" Header="VRChat group id (group button)" PlaceholderText="grp_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                        <Button x:Name="CopyGroupBtn" Grid.Column="1" Click="CopyGroupBtn_Click" VerticalAlignment="Bottom" Padding="10,6" ToolTipService.ToolTip="Copy group id">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                        </Button>
                        <Button x:Name="OpenGroupBtn" Grid.Column="2" Click="OpenGroupBtn_Click" VerticalAlignment="Bottom" Padding="10,6" ToolTipService.ToolTip="Open group page">
                            <FontIcon Glyph="&#xE774;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AvatarBox" Header="VRChat avatar id (cardboard avatar)" PlaceholderText="avtr_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                        <Button x:Name="OpenAvatarBtn" Grid.Column="1" Click="OpenAvatarBtn_Click" VerticalAlignment="Bottom" Padding="10,6" ToolTipService.ToolTip="Open avatar page">
                            <FontIcon Glyph="&#xE774;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <TextBox x:Name="WorldsBox" Header="World ids (one wrld_ id per line, max 8)"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="92" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="wrld_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                    <TextBox x:Name="ImagesBox" Header="Booth image URLs (one per line, max 12)"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="92" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="https://..."/>
                    <TextBox x:Name="LogoBox" Header="Logo URL" PlaceholderText="https://..."/>
                    <TextBox x:Name="PublicBox" Header="Public link (website, Discord invite...)" PlaceholderText="https://..."/>

                    <StackPanel x:Name="AdminOnlyPanel" Spacing="12">
                        <TextBox x:Name="AssignedBox" Header="Assigned team members (one Discord id per line)"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="72" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="123456789012345678"/>
                        <ToggleSwitch x:Name="PublishedToggle" Header="Published" OnContent="Live in the Alley lineup" OffContent="Draft"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="22,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                <TextBlock Text="Save booth"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF6B6B"/>
                                <TextBlock Text="Delete" Foreground="#FF6B6B"/>
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="SaveBusy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                    </StackPanel>

                    <InfoBar x:Name="StatusBar" IsOpen="False"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
