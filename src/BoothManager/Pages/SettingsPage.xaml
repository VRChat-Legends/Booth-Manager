<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>

            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sound" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="MusicToggle" Header="Background music" Toggled="MusicToggle_Toggled"/>
                    <ToggleSwitch x:Name="SfxToggle" Header="UI sounds" Toggled="SfxToggle_Toggled"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Updates" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource AlleyMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckBtn" Click="CheckBtn_Click" Content="Check for updates"/>
                        <ProgressRing x:Name="CheckBusy" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Connection" FontWeight="SemiBold"/>
                    <TextBox x:Name="ApiBox" Header="API base URL"/>
                    <Button x:Name="SaveApiBtn" Click="SaveApiBtn_Click" Content="Save connection"/>
                    <TextBlock Text="Leave this as https://api.vrchatlegends.com unless the team tells you otherwise."
                               Foreground="{StaticResource AlleyMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Account" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccountText" Foreground="{StaticResource AlleyMutedBrush}"/>
                    <Button x:Name="SignOutBtn" Click="SignOutBtn_Click" Content="Sign out"/>
                </StackPanel>
            </Border>

            <TextBlock Foreground="{StaticResource AlleyMutedBrush}" FontSize="11" TextWrapping="Wrap"
                       Text="Booth Manager is proprietary software, Copyright (c) 2026 VRChat Legends. All rights reserved. Standee concept inspired by Auto-Standee by Sketch494 (original implementation, no GPL code)."/>
        </StackPanel>
    </ScrollViewer>
</Page>
