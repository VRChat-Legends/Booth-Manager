<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="RootPanel" Padding="28" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock x:Name="WelcomeText" Text="Welcome back" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="SubText" Text="Here is what is happening in Legends Alley."
                       Foreground="{StaticResource AlleyMutedBrush}" Margin="0,-12,0,0"/>

            <!-- event hero -->
            <Border x:Name="EventHero" Visibility="Collapsed" CornerRadius="{StaticResource CardRadius}" Padding="24,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A00E6CC" Offset="0"/>
                        <GradientStop Color="#0D101720" Offset="0.55"/>
                        <GradientStop Color="#2200E6CC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="EventName" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="EventDate" FontSize="13" Foreground="{StaticResource AlleyMutedBrush}"/>
                        <TextBlock x:Name="EventLineupNote" FontSize="12" Foreground="{StaticResource AlleyTealBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="CdDays" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="DAYS" FontSize="10" Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center" CharacterSpacing="120"/>
                        </StackPanel>
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="CdHours" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="HOURS" FontSize="10" Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center" CharacterSpacing="120"/>
                        </StackPanel>
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="CdMins" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="MINS" FontSize="10" Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center" CharacterSpacing="120"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TileBooths" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}"/>
                        <TextBlock x:Name="TileBoothsLabel" Text="Booths" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TilePublished" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}"/>
                        <TextBlock Text="Published" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TileImages" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}"/>
                        <TextBlock Text="Booth images" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TileWorlds" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AlleyTealBrush}"/>
                        <TextBlock Text="Linked worlds" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GoBoothsBtn" Click="GoBoothsBtn_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                        <TextBlock Text="Manage booths"/>
                    </StackPanel>
                </Button>
                <Button x:Name="GoBuilderBtn" Click="GoBuilderBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE90F;" FontSize="14"/>
                        <TextBlock Text="3D booth builder"/>
                    </StackPanel>
                </Button>
                <Button x:Name="GoStandeeBtn" Click="GoStandeeBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                        <TextBlock Text="Make a standee"/>
                    </StackPanel>
                </Button>
                <Button x:Name="GoAtlasBtn" Click="GoAtlasBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                        <TextBlock Text="Pack an atlas"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- website quick links -->
            <Border Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="vrchatlegends.com" FontSize="12" Foreground="{StaticResource AlleyMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <HyperlinkButton x:Name="LinkAlley" Content="/alley" Click="WebLink_Click" Tag="https://vrchatlegends.com/alley" FontSize="12"/>
                    <HyperlinkButton x:Name="LinkDash" Content="/alley/dashboard" Click="WebLink_Click" Tag="https://vrchatlegends.com/alley/dashboard" FontSize="12"/>
                    <HyperlinkButton x:Name="LinkAdmin" Content="/alley/admin" Click="WebLink_Click" Tag="https://vrchatlegends.com/alley/admin" FontSize="12" Visibility="Collapsed"/>
                    <HyperlinkButton x:Name="LinkApply" Content="/alley/apply" Click="WebLink_Click" Tag="https://vrchatlegends.com/alley/apply" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- community lineup -->
            <Grid>
                <TextBlock Text="Event lineup" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="LineupCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource AlleyMutedBrush}"/>
            </Grid>
            <ItemsControl x:Name="LineupPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="232" ItemHeight="84"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="LineupEmpty" Text="Lineup not announced yet." FontSize="12"
                       Foreground="{StaticResource AlleyMutedBrush}" Visibility="Collapsed"/>

            <TextBlock Text="Your booths" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <StackPanel x:Name="RecentList" Spacing="8"/>
            <TextBlock x:Name="EmptyText" Text="No booths yet." Foreground="{StaticResource AlleyMutedBrush}" Visibility="Collapsed"/>
            <InfoBar x:Name="StatusBar" IsOpen="False"/>
        </StackPanel>
    </ScrollViewer>
</Page>
