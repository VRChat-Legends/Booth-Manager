<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.StandeePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="14">
                <TextBlock Text="Standee Studio" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Turn a picture into a cardboard standee mesh (OBJ + texture) for your booth."
                           Foreground="{StaticResource AlleyMutedBrush}" TextWrapping="Wrap" Margin="0,-6,0,0"/>

                <Button x:Name="PickBtn" Click="PickBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                        <TextBlock Text="Choose image"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FileText" Text="No image selected. Transparent PNGs work best; plain backgrounds are keyed out automatically."
                           Foreground="{StaticResource AlleyMutedBrush}" FontSize="12" TextWrapping="Wrap"/>

                <NumberBox x:Name="HeightBox" Header="Standee height (meters)" Value="1.7" Minimum="0.3" Maximum="5"
                           SmallChange="0.1" SpinButtonPlacementMode="Inline"/>
                <NumberBox x:Name="ThickBox" Header="Thickness (cm)" Value="3" Minimum="0.5" Maximum="20"
                           SmallChange="0.5" SpinButtonPlacementMode="Inline"/>
                <ComboBox x:Name="QualityCombo" Header="Outline quality" SelectedIndex="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Low (fast)"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High (detailed)"/>
                </ComboBox>
                <ToggleSwitch x:Name="FlapToggle" Header="Back support flap" IsOn="True"
                              OnContent="Classic cardboard stand" OffContent="Flat cutout only"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="GenerateBtn" Click="GenerateBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="22,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                            <TextBlock Text="Generate standee"/>
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False"/>
                <Button x:Name="OpenFolderBtn" Click="OpenFolderBtn_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        <TextBlock Text="Open export folder"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Concept inspired by Auto-Standee by Sketch494. This is an original implementation."
                           Foreground="{StaticResource AlleyMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{StaticResource AlleyCardBrush}" BorderBrush="{StaticResource AlleyCardBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button x:Name="View3DBtn" Content="3D" FontSize="12" Click="View3DBtn_Click" IsEnabled="False"/>
                    <Button x:Name="View2DBtn" Content="Silhouette" FontSize="12" Click="View2DBtn_Click" IsEnabled="False"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="PreviewPlaceholder" Text="Generate a standee and it appears here in 3D. Drag to orbit, scroll to zoom."
                               Foreground="{StaticResource AlleyMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                    <Image x:Name="PreviewImg" Stretch="Uniform" Visibility="Collapsed"/>
                    <Grid x:Name="Preview3DHost" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
