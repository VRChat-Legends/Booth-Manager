<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BoothManager.Pages.AlleyAdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Alley Admin" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="Subtitle" Foreground="{StaticResource AlleyMutedBrush}" FontSize="12"
                           Text="Staff console, same as vrchatlegends.com/alley/admin."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenWebBtn" Click="OpenWebBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14"/>
                        <TextBlock Text="Open on the website"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- header stats -->
        <Grid x:Name="StatsRow" Grid.Row="1" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="StatSlot0" Grid.Column="0"/>
            <Grid x:Name="StatSlot1" Grid.Column="1"/>
            <Grid x:Name="StatSlot2" Grid.Column="2"/>
        </Grid>

        <!-- gate -->
        <Border x:Name="GatePanel" Grid.Row="2" Background="{StaticResource AlleyCardBrush}"
                BorderBrush="{StaticResource AlleyCardBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="40" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7EF;" FontSize="42" Foreground="{StaticResource AlleyTealBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="GateTitle" Text="Staff sign-in required" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="GateText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AlleyMutedBrush}"
                           Text="Applications, communities, events, and booth uploads. Sign in with a staff Discord account on the Alley Dashboard tab first."/>
                <TextBlock x:Name="GateError" Foreground="#FF6B81" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="GateConnectBtn" Click="GateConnectBtn_Click" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FB;" FontSize="14"/>
                        <TextBlock Text="Sign in with Discord"/>
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="GateRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- content -->
        <Grid x:Name="ContentRoot" Grid.Row="2" Visibility="Collapsed" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="TabAppsBtn" Click="Tab_Click" Tag="0" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE715;" FontSize="13"/><TextBlock Text="Applications"/>
                        <Border x:Name="PendingBadge" Background="#33F59E0B" CornerRadius="8" Padding="7,1" Visibility="Collapsed">
                            <TextBlock x:Name="PendingBadgeText" FontSize="11" FontWeight="Bold" Foreground="#FCD34D"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="TabCommsBtn" Click="Tab_Click" Tag="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE716;" FontSize="13"/><TextBlock Text="Communities"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabEventsBtn" Click="Tab_Click" Tag="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE787;" FontSize="13"/><TextBlock Text="Events"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabBoothsBtn" Click="Tab_Click" Tag="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B8;" FontSize="13"/><TextBlock Text="Booths"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <Grid>
                    <StackPanel x:Name="AppsTab" Spacing="10" MaxWidth="980" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="CommsTab" Spacing="10" MaxWidth="980" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <StackPanel x:Name="EventsTab" Spacing="10" MaxWidth="980" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <StackPanel x:Name="BoothsTab" Spacing="10" MaxWidth="980" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
